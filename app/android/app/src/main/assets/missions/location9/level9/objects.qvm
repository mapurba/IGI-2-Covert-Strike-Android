// --- PLAYER ---
HumanPlayer(
    Position = (102, 102, 145)
    Gamma = 180
    Model = 'player'
    Team = 0
    Weapon = 'SetupWeapons'
    1st Person Model = 'arms_player'
    Visibility Gamma = 2.0
    Visibility Minimum = 0.1
    Visibility Maximum = 0.9
    Carry over weapons from previous mission = FALSE
);

// --- PLAYER WEAPONS ---
SetupWeapons()
{
    GiveWeapon(SniperRifle);
    SetAmmo(SniperRifle, 150);
    GiveWeapon(AssaultRifle);
    SetAmmo(AssaultRifle, 120);
    GiveWeapon(Knife);
}

